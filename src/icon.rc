/* Ícone do executável (gerado de icon.png) */
1 ICON "icon.ico"


/* Version Information */
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Decomp It Up Team"
            VALUE "FileDescription",  "Decomp It Up: New Xenesis"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Pumpy"
            VALUE "LegalCopyright",   "Copyright (C) 2006 Andamiro / Decomp Team"
            VALUE "OriginalFilename", "Pumpy.exe"
            VALUE "ProductName",      "Decomp It Up: New Xenesis"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
